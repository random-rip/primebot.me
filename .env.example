# Nuxt Studio – GitHub OAuth app (production only)
# Authorization callback URL: https://<your-domain>/__nuxt_studio/auth/github
NUXT_STUDIO_AUTH_GITHUB_CLIENT_ID=
NUXT_STUDIO_AUTH_GITHUB_CLIENT_SECRET=
# Optional: comma-separated list of GitHub users allowed to edit
# NUXT_STUDIO_AUTH_GITHUB_MODERATORS=
