# Nuxt Studio – GitHub OAuth app (runtime env, production only)
# Homepage URL: https://primebot.me
# Authorization callback URL: https://primebot.me/__nuxt_studio/auth/github
NUXT_STUDIO_AUTH_GITHUB_CLIENT_ID=
NUXT_STUDIO_AUTH_GITHUB_CLIENT_SECRET=
# Behind Traefik (TLS terminated at the proxy) Studio would otherwise build an http:// callback URL
NUXT_STUDIO_AUTH_GITHUB_REDIRECT_URL=https://primebot.me/__nuxt_studio/auth/github
# Optional: comma-separated GitHub account emails allowed to log in (empty = any GitHub user)
# NUXT_STUDIO_AUTH_GITHUB_MODERATORS=
# Optional: session cookie key (32+ chars, e.g. `openssl rand -hex 32`); derived from the OAuth credentials when unset
# NUXT_STUDIO_AUTH_SESSION_SECRET=
