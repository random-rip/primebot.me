# Nuxt Studio – GitHub OAuth app (production only)
# Authorization callback URL: https://<your-domain>/__nuxt_studio/auth/github
NUXT_STUDIO_AUTH_GITHUB_CLIENT_ID=
NUXT_STUDIO_AUTH_GITHUB_CLIENT_SECRET=
# Encrypts the Studio session cookie (min. 32 chars, e.g. `openssl rand -hex 32`). nuxt-studio derives it from
# the OAuth credentials at *build* time, which are empty in the Docker build → always set it at runtime
NUXT_STUDIO_AUTH_SESSION_SECRET=
# Required behind a TLS-terminating proxy (Traefik), otherwise Studio sends an http:// callback to GitHub
# (nuxt-studio 1.7 reads STUDIO_GITHUB_REDIRECT_URL, not the NUXT_STUDIO_AUTH_GITHUB_REDIRECT_URL from the docs)
STUDIO_GITHUB_REDIRECT_URL=https://primebot.me/__nuxt_studio/auth/github
# Optional: comma-separated list of GitHub account *emails* allowed to edit (empty = every GitHub user can log in)
# STUDIO_GITHUB_MODERATORS=
